{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "hosting": {
    "public": ".",
    "predeploy": [
      "test -f lib/firebase-config.js || (echo 'lib/firebase-config.js is missing \u2014 copy lib/firebase-config.example.js' && exit 1)"
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ],
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "**/*.log",
      ".git/**",
      ".claude/**",
      ".superpowers/**",
      ".playwright-mcp/**",
      "docs/**",
      "tests/**",
      "rules-tests/**",
      "serve.py",
      "package.json",
      "AGENTS.md",
      "CLAUDE.md",
      "README.md",
      "firestore.rules",
      "firestore.indexes.json",
      "lib/firebase-config.example.js",
      "**/*.pem",
      "**/*.key",
      "**/*.p12",
      "**/*.pfx",
      "**/*service-account*.json",
      "**/*-credentials.json",
      "emulator-data/**",
      "firebase-export-*/**",
      "auth-export*.json"
    ]
  },
  "emulators": {
    "auth": {
      "port": 9099
    },
    "firestore": {
      "port": 8080
    },
    "ui": {
      "enabled": false
    },
    "singleProjectMode": true
  }
}
